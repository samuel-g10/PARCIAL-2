def pedir_entero(mensaje, minimo, maximo):
    while True:
        texto = input(mensaje)
        try:
            numero = int(texto)
        except ValueError:
            print("Error: debe escribir un número entero.")
            continue

        if numero < minimo or numero > maximo:
            print("Error: el número debe estar entre", minimo, "y", maximo)
        else:
            return numero
